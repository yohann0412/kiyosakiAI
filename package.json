{
  "name": "doc-to-sheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "NODE_USE_ENV_PROXY=1 tsx scripts/eval.ts",
    "eval:guard": "tsx scripts/eval-guard.ts",
    "metrics": "NODE_USE_ENV_PROXY=1 tsx scripts/metrics.ts",
    "leads:sync": "NODE_USE_ENV_PROXY=1 tsx scripts/sync-leads.ts",
    "purge": "tsx scripts/purge.ts",
    "check": "npm run typecheck && npm run test && npm run eval:guard",
    "postinstall": "node scripts/copy-pdf-worker.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "samples": "NODE_USE_ENV_PROXY=1 tsx scripts/make-samples.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@vercel/blob": "^2.9.0",
