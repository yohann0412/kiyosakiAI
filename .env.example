# ---- Extraction (required for the converter to work) ------------------------
ANTHROPIC_API_KEY=
# Model, depth and caps. Defaults shown.
# EXTRACTOR_MODEL=claude-opus-5-5
# EXTRACTOR_EFFORT=low
# EXTRACTOR_MAX_PAGES=10
# EXTRACTOR_MAX_OUTPUT_TOKENS=16000
# Local development without a key: canned sample data, clearly labelled.
# EXTRACTOR_PROVIDER=mock

# ---- App ---------------------------------------------------------------------
# Signs the session cookies. Required in production. `openssl rand -base64 32`
APP_SECRET=
# Canonical site address (no trailing slash). Defaults to the Vercel production URL.
# SITE_URL=https://example.com
# SITE_NAME=Sheetlift
# CONTACT_EMAIL=
# GOOGLE_SITE_VERIFICATION=
# Model spend ceiling per day in USD (default 1.5, about $45 a month).
# DAILY_BUDGET_USD=1.5
# Protects /api/cron/purge. Vercel Cron sends it automatically when set.
CRON_SECRET=

# ---- Storage for leads, emails, events and counters --------------------------
# Local files under .data/ are used when nothing is set (development only).
# Vercel Blob: connect a Blob store to the project; it sets BLOB_READ_WRITE_TOKEN.
# Supabase Storage:
# STORE_DRIVER=supabase
# STORE_SUPABASE_URL=
# STORE_SUPABASE_KEY=
# STORE_SUPABASE_BUCKET=doc-tool

# ---- Email (optional) --------------------------------------------------------
# Resend. Sends the one confirmation email to users and lead alerts to Yohann.
# RESEND_API_KEY=
# EMAIL_FROM="Sheetlift <hello@yourdomain.com>"
# Where new-lead alerts go.
# ALERT_EMAIL_TO=
# Slack or Discord incoming webhook for new-lead alerts.
# ALERT_WEBHOOK_URL=
